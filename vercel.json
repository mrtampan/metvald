{
  "rewrites": [
    {
      "source": "/clobr-api/:path*",
      "destination": "https://clobr.io/:path*"
    },
    {
      "source": "/solbundler-api/:path*",
      "destination": "https://solbundler.app/:path*"
    },
    {
      "source": "/((?!api/|@vite/|@id/|@fs/|node_modules/|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}